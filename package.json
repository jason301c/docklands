{
	"name": "docklands-workspace",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"workspaces": [
		"apps/*"
	],
	"scripts": {
		"prepare": "if git rev-parse --git-dir >/dev/null 2>&1; then git config core.hooksPath .githooks; fi",
		"dev": "bun --filter docklands --elide-lines=0 dev",
		"build": "bun --filter docklands build",
		"start": "bun --filter docklands start",
		"setup": "bun --filter docklands setup",
		"typecheck": "bun --filter docklands typecheck",
		"test": "bun --filter docklands test",
		"test:ci": "bun run check:bundler && bun --filter docklands test:ci",
		"test:coverage": "bun --filter docklands test:coverage",
		"format-and-lint": "bun --filter docklands format-and-lint",
		"format-and-lint:fix": "bun --filter docklands format-and-lint:fix",
		"check:bundler": "bun tools/check-bundler.mjs",
		"check:baseui": "bun --filter docklands check:baseui",
		"check:openapi": "bun --filter docklands check:openapi",
		"generate:openapi": "bun --filter docklands generate:openapi",
		"reset-password": "bun --filter docklands reset-password",
		"rotate-encryption-key": "bun --filter docklands rotate-encryption-key",
		"restore-instance": "bun --filter docklands restore-instance",
		"migration:generate": "cd apps/docklands && bun run migration:generate",
		"migration:run": "bun --filter docklands migration:run",
		"migration:up": "cd apps/docklands && bun run migration:up",
		"migration:drop": "cd apps/docklands && bun run migration:drop",
		"db:push": "bun --filter docklands db:push",
		"db:studio": "bun --filter docklands db:studio",
		"db:clean": "bun --filter docklands db:clean",
		"docs:dev": "bun --filter docs dev",
		"docs:check-current": "node tools/check-docs-current.mjs",
		"docs:build": "node tools/check-docs-current.mjs && bun --filter docs build",
		"docs:preview": "bun --filter docs preview",
		"docs:typecheck": "bun --filter docs typecheck",
		"site:dev": "bun --filter site dev",
		"site:build": "bun --filter site build",
		"site:start": "bun --filter site start",
		"site:typecheck": "bun --filter site typecheck",
		"site:lint": "bun --filter site lint",
		"site:format": "bun --filter site format",
		"docker:build": "./tools/docker/build.sh",
		"docker:smoke": "./tools/docker/smoke-image.sh",
		"docker:smoke:operator": "./tools/docker/smoke-operator.sh",
		"docker:smoke:deploy": "./tools/docker/smoke-deploy.sh",
		"docker:push": "./tools/docker/push.sh",
		"docker:build:canary": "./tools/docker/build.sh canary",
		"docker:push:canary": "./tools/docker/push.sh canary",
		"release:smoke:host": "./tools/release/host-operator-smoke.sh",
		"release:check-metadata": "node tools/release/check-metadata.mjs",
		"release:tag": "./tools/release/tag-release.sh",
		"release:preflight": "./tools/release/preflight.sh",
		"release:smoke:dispatch": "./tools/release/dispatch-smoke-workflows.sh"
	},
	"packageManager": "bun@1.3.14",
	"engines": {
		"node": ">=24.4.0 <26",
		"bun": ">=1.3.14"
	},
	"trustedDependencies": [
		"@scarf/scarf",
		"@tree-sitter-grammars/tree-sitter-yaml",
		"bcrypt",
		"better-sqlite3",
		"core-js-pure",
		"cpu-features",
		"esbuild",
		"msgpackr-extract",
		"node-pty",
		"protobufjs",
		"sharp",
		"ssh2",
		"tree-sitter",
		"tree-sitter-json"
	]
}
