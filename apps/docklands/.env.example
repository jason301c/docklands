DATABASE_URL="postgres://docklands:amukds4wi9001583845717ad2@localhost:5432/docklands"
PORT=3000
NODE_ENV=development

# `bun run setup` generates BETTER_AUTH_SECRET automatically for local installs.
# Production installs should set BETTER_AUTH_SECRET_FILE or BETTER_AUTH_SECRET.
# Production installs should set DATABASE_URL or POSTGRES_PASSWORD_FILE.

# Encryption key for secrets at rest (SSH keys, provider tokens, registry/SMTP
# passwords, S3 credentials, database config, env values). A base64-encoded
# 32-byte key, SEPARATE from BETTER_AUTH_SECRET. `bun run setup` generates one
# for local installs; production installs should set DOCKLANDS_ENCRYPTION_KEY or
# DOCKLANDS_ENCRYPTION_KEY_FILE. Generate with: openssl rand -base64 32
# Losing/rotating this key makes existing encrypted values unrecoverable.
# DOCKLANDS_ENCRYPTION_KEY="..."

# Optional. Stable external URL of this Docklands instance (e.g.
# https://docklands.example.com). When set, Better Auth uses it for absolute
# callback/verification links. Leave unset to derive the origin from the
# incoming request, which is fine for multi-host self-hosted installs. In dev
# it defaults to http://localhost:${PORT}.
# BETTER_AUTH_URL="https://docklands.example.com"
