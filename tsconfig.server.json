{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"module": "ESNext",
		"outDir": "dist/",
		"target": "ESNext",
		"isolatedModules": false,
		"noEmit": false,
		"moduleResolution": "Node",
		"baseUrl": ".",
		"paths": {
			"@/*": ["./*"],
			"@/server-core/*": ["./server-core/*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"./server/**/*",
		"./server-core/**/*",
		"./migration.ts",
		"./setup.ts",
		"./wait-for-postgres.ts",
		"./reset-password.ts",
		"./reset-2fa.ts",
		"./scripts/**/*"
	]
}
