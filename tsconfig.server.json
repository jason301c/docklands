{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"ignoreDeprecations": "6.0",
		"module": "ESNext",
		"outDir": "dist/",
		"target": "ESNext",
		"isolatedModules": false,
		"noEmit": false,
		"moduleResolution": "Node",
		"baseUrl": ".",
		"paths": {
			"@/*": ["./*"],
			"@/server/core/*": ["./server/core/*"]
		}
	},
	"include": ["next-env.d.ts", "./server/**/*", "./tools/**/*"]
}
